# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_BACKEND=local
# local: google/embeddinggemma-2B (mặc định, cần RAM ~8GB) hoặc
# all-MiniLM-L6-v2 (nhẹ, máy yếu); openrouter: model embedding bất kỳ.
EMBEDDING_MODEL=google/embeddinggemma-2B
# Vector store: 'pgvector' (cần Docker, xem README) hoặc 'chroma' (local,
# không cần Docker - python -m pip install chromadb; dữ liệu nằm trong
# thư mục Chroma_PATH bên dưới).
VECTOR_STORE=chroma
CHROMA_PATH=
